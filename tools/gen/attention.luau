-- Renders `src/ops/generated/init.luau` and a module per head size beside it: causal attention with the dot
-- products over a head written out in straight line code, one function per head size, for the f32 cache here and for
-- the Q8 cache in `attention_q8.luau`. Four positions share each query vector, the softmax weights come from a vector
-- `exp`, and the value sum keeps four lanes of the head in locals over four positions per pass. Needs
-- `buffer.readvectorf32x3`, a lane is 3 floats, a head of `hdPad` floats is `hdPad / 3` lanes. Pure text, like `generate`.

const attentionQ8 = require("./attention_q8")
const emit = require("./emit")
const vexp = require("./vexp")

--- Lane counts with a function: 4 is the test head, 22 is 64 wide heads, 32 is 96, 43 is 128, 86 is 256.
const LANES = { 4, 22, 32, 43, 86 }

--- Positions per pass of the dot products and of the value sum.
const POSITIONS = 4

--- The aggregate's path relative to the repository root. A Roblox ModuleScript holds at most 199,997 characters, so each
--- head size is a module of its own and the aggregate only gathers them.
const PATH = "src/ops/generated/init.luau"

--- The path of the module of the head size `lanes`.
const function sizePath(lanes: number): string
    return `src/ops/generated/attention_unrolled_{lanes}.luau`
end

const PRELUDE = [[
--!native
--!optimize 2
--!nonstrict
-- Generated by tools/gen/attention.luau. Do not edit, run lute run tools/gen/main.luau.
-- Causal attention like `attention_vector`, unrolled for one head size.

const opsTypes = require("@src/ops/types")

]] .. vexp.TEXT

--- One position of `buffer.readvectorf32x3(b, base + off)`, with no `+ 0`.
const function read(b: string, base: string, off: number): string
    return `buffer.readvectorf32x3({b}, {emit.plus(base, off)})`
end

--- The dot products of `R` positions starting at `j` with the query: writes their scores and takes the running max.
const function dots(e: emit.Emitter, lanes: number, R: number)
    const row = lanes * 12
    emit.line(e, `const kb = cacheBase + (first + j) * {row}`)
    for i = 0, lanes - 1 do
        const open = i > 0
        if open then
            emit.open(e, "do")
        end
        emit.line(e, `const q{i} = {read("q", "qb", 12 * i)}`)
        for r = 0, R - 1 do
            const key = read("keys", "kb", row * r + 12 * i)
            if i == 0 then
                emit.line(e, `local a{r} = q{i} * {key}`)
            else
                emit.line(e, `a{r} = a{r} + q{i} * {key}`)
            end
        end
        if open then
            emit.close(e)
        end
    end
    const names: { string } = {}
    for r = 0, R - 1 do
        emit.line(e, `const d{r} = (a{r}.x + a{r}.y + a{r}.z) * scale`)
        emit.line(e, `buffer.writef32(scores, {emit.plus("j * 4", 4 * r)}, d{r})`)
        table.insert(names, `d{r}`)
    end
    if R == 1 then
        emit.open(e, "if d0 > maxScore then")
        emit.line(e, "maxScore = d0")
        emit.close(e)
    else
        emit.line(e, `maxScore = math.max(maxScore, {table.concat(names, ", ")})`)
    end
end

--- The sum over the positions of the weights times the values for lanes `lane` to `lane + n - 1`.
const function mix(e: emit.Emitter, lanes: number, lane: number, n: number)
    const row = lanes * 12
    const vs: { string } = {}
    for k = 0, n - 1 do
        table.insert(vs, `v{k}`)
    end
    emit.open(e, "do")
    const zeros: { string } = {}
    for _ = 1, n do
        table.insert(zeros, "vector.zero")
    end
    emit.line(e, `local {table.concat(vs, ", ")} = {table.concat(zeros, ", ")}`)
    emit.open(e, `for j = 0, n4 - 1, {POSITIONS} do`)
    emit.line(e, `const vb = {emit.plus(`vBase + j * {row}`, 12 * lane)}`)
    for s = 0, POSITIONS - 1 do
        emit.line(e, `const p{s} = buffer.readf32(scores, {emit.plus("j * 4", 4 * s)})`)
    end
    for k = 0, n - 1 do
        const terms: { string } = {}
        for s = 0, POSITIONS - 1 do
            table.insert(terms, `{read("values", "vb", row * s + 12 * k)} * p{s}`)
        end
        emit.line(e, `v{k} = v{k} + ({terms[1]} + {terms[2]}) + ({terms[3]} + {terms[4]})`)
    end
    emit.close(e)
    emit.open(e, "for j = n4, n - 1 do")
    emit.line(e, `const vb = {emit.plus(`vBase + j * {row}`, 12 * lane)}`)
    emit.line(e, "const p = buffer.readf32(scores, j * 4)")
    for k = 0, n - 1 do
        emit.line(e, `v{k} = v{k} + {read("values", "vb", 12 * k)} * p`)
    end
    emit.close(e)
    for k = 0, n - 1 do
        const d = 3 * (lane + k)
        const at = emit.plus("ob", 4 * d)
        if lane + k == lanes - 1 then
            emit.line(e, `storeEdge(out, v{k} * inv, {at}, hd - {d})`)
        else
            emit.line(e, `const w{k} = v{k} * inv`)
            emit.line(e, `buffer.writef32(out, {at}, w{k}.x)`)
            emit.line(e, `buffer.writef32(out, {emit.plus("ob", 4 * d + 4)}, w{k}.y)`)
            emit.line(e, `buffer.writef32(out, {emit.plus("ob", 4 * d + 8)}, w{k}.z)`)
        end
    end
    emit.close(e)
end

--- The text of the function for heads of `lanes` lanes. A `stage` of "dots" or "softmax" ends each head after the dot
--- products or after the softmax, for `tools/bench/attention_profile.luau` to time the parts by difference.
const function render(lanes: number, stage: string?): string
    const e = emit.new()
    emit.open(
        e,
        `const function attend{lanes}(s: opsTypes.Shape, q: buffer, tokens: number, keys: buffer, values: buffer, pos0: number, out: buffer, outStride: number, scores: buffer, _acc: \{ number })`
    )
    emit.line(e, "const hd, context = s.headDim, s.context")
    emit.line(e, "const group, headBase, kvBase = s.group, s.headBase, s.kvBase")
    emit.line(e, "const scale = s.scale")
    emit.line(e, `const rowBytes = {lanes * 12}`)
    emit.open(e, "for t = 0, tokens - 1 do")
    emit.line(e, "const last = pos0 + t")
    emit.line(e, "local first = 0")
    emit.open(e, "if s.window ~= nil and last - s.window + 1 > 0 then")
    emit.line(e, "first = last - s.window + 1")
    emit.close(e)
    emit.line(e, "const n = last - first + 1")
    emit.line(e, `const n4 = n - n % {POSITIONS}`)
    emit.line(e, "const nt = n // 3")
    emit.open(e, "for h = 0, s.heads - 1 do")
    emit.line(e, "const g = (headBase + h) // group - kvBase")
    emit.line(e, "const qb = ((t * s.heads) + h) * rowBytes")
    emit.line(e, "const cacheBase = g * context * rowBytes")
    emit.line(e, "local maxScore = -math.huge")
    emit.open(e, `for j = 0, n4 - 1, {POSITIONS} do`)
    dots(e, lanes, POSITIONS)
    emit.close(e)
    emit.open(e, "for j = n4, n - 1 do")
    dots(e, lanes, 1)
    emit.close(e)
    if stage == "dots" then
        emit.line(e, "if maxScore == maxScore then continue end")
    end
    emit.line(e, "const mv = vector.create(maxScore, maxScore, maxScore)")
    emit.line(e, "local tv = vector.zero")
    emit.open(e, "for i = 0, nt * 12 - 1, 12 do")
    emit.line(e, "const w = vexp(buffer.readvectorf32x3(scores, i) - mv)")
    emit.line(e, "buffer.writevectorf32x3(scores, i, w)")
    emit.line(e, "tv = tv + w")
    emit.close(e)
    emit.line(e, "local total = tv.x + tv.y + tv.z")
    emit.open(e, "for j = nt * 3, n - 1 do")
    emit.line(e, "const w = math.exp(buffer.readf32(scores, j * 4) - maxScore)")
    emit.line(e, "buffer.writef32(scores, j * 4, w)")
    emit.line(e, "total += w")
    emit.close(e)
    emit.line(e, "const inv = 1 / total")
    if stage == "softmax" then
        emit.line(e, "if inv == inv then continue end")
    end
    emit.line(e, "const ob = (t * outStride + h * hd) * 4")
    emit.line(e, "const vBase = cacheBase + first * rowBytes")
    local lane = 0
    while lane < lanes do
        const n = math.min(4, lanes - lane)
        mix(e, lanes, lane, n)
        lane += n
    end
    emit.close(e)
    emit.close(e)
    emit.close(e)
    return emit.text(e)
end

--- The text of the module of the head size `lanes`, which returns its function. A `stage` ends each head early, see
--- `render`.
const function renderSize(lanes: number, stage: string?): string
    return table.concat({ PRELUDE, render(lanes, stage), `return attend{lanes}` }, "\n") .. "\n"
end

--- The text of the whole attention in one module with `byLanes`, which `tools/bench/attention_profile.luau` loads for its
--- stage functions.
const function renderModule(stage: string?): string
    const parts: { string } = { PRELUDE }
    for _, lanes in LANES do
        table.insert(parts, render(lanes, stage))
    end
    table.insert(parts, "return {")
    table.insert(parts, "    byLanes = {")
    for _, lanes in LANES do
        table.insert(parts, `        [{lanes}] = attend{lanes},`)
    end
    table.insert(parts, "    },")
    table.insert(parts, "}")
    return table.concat(parts, "\n") .. "\n"
end

--- The text of the aggregate: `byLanes[hdPad / 3]` has the function of a head size for the f32 cache, `q8ByLanes` the one
--- for the Q8 cache.
const function renderAggregate(): string
    const parts: { string } = {
        "--!native",
        "--!optimize 2",
        "--!nonstrict",
        "-- Generated by tools/gen/attention.luau. Do not edit, run lute run tools/gen/main.luau.",
        "-- `byLanes[hdPad / 3]` has the unrolled attention function of a head size for the f32 cache, `q8ByLanes` the one for",
        "-- the vector layout of the Q8 cache, each in a module of its own.",
        "",
    }
    for _, lanes in LANES do
        table.insert(parts, `const attend{lanes} = require("@self/attention_unrolled_{lanes}")`)
    end
    for _, lanes in attentionQ8.LANES do
        table.insert(parts, `const attendQ8_{lanes} = require("@self/attention_q8_unrolled_{lanes}")`)
    end
    table.insert(parts, "")
    table.insert(parts, "return {")
    table.insert(parts, "    byLanes = {")
    for _, lanes in LANES do
        table.insert(parts, `        [{lanes}] = attend{lanes},`)
    end
    table.insert(parts, "    },")
    table.insert(parts, "    q8ByLanes = {")
    for _, lanes in attentionQ8.LANES do
        table.insert(parts, `        [{lanes}] = attendQ8_{lanes},`)
    end
    table.insert(parts, "    },")
    table.insert(parts, "}")
    return table.concat(parts, "\n") .. "\n"
end

--- Every file of the attention: the module per head size for each cache, then the aggregate.
const function renderFiles(): { { path: string, text: string } }
    const out = {}
    for _, lanes in LANES do
        table.insert(out, { path = sizePath(lanes), text = renderSize(lanes) })
    end
    for _, lanes in attentionQ8.LANES do
        table.insert(out, { path = attentionQ8.sizePath(lanes), text = attentionQ8.renderSize(lanes) })
    end
    table.insert(out, { path = PATH, text = renderAggregate() })
    return out
end

return {
    LANES = LANES,
    PATH = PATH,
    sizePath = sizePath,
    renderSize = renderSize,
    renderModule = renderModule,
    renderAggregate = renderAggregate,
    renderFiles = renderFiles,
}
