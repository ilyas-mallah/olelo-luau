-- Renders a module per head size, `src/ops/generated/attention_q8_unrolled_<lanes>.luau`: causal attention over the Q8
-- KV cache in its vector layout (`kvquant`, `v3`). A row of a head is stored three int8 values to an f32 lane: a lane
-- holds `c + b / 256 + a / 65536` for three offset binary bytes (value + 128), which is exact in f32, and one
-- `buffer.readvectorf32x3` reads three lanes, nine values. The kernel takes the bytes apart with `vector.floor`:
-- `c = floor(p)`, `x = (p - c) * 256`, `b = floor(x)`, `a = (x - b) * 256`. The three bytes of a lane are the values of
-- three consecutive triples of the head, so the query vectors that multiply them are plain reads of the query row. The
-- offset 128 comes off at the end: the sum of the query times 128 for a score, the sum of the weights times 128 for a
-- value. Three positions share each query vector like in `attention`'s unrolled kernel, the softmax weights come from
-- the vector `exp`, and the weights carry the value scale of their position. The aggregate that gathers the modules is
-- written by `attention.luau`.

const emit = require("./emit")
const vexp = require("./vexp")

--- Lane counts with a function, as in `attention.luau`.
const LANES = { 4, 22, 32, 43, 86 }

--- Positions per pass of the dot products and of the value sum. Three keeps the Windows target at 16 spill slots where
--- four take 23, the most native lowering allows.
const POSITIONS = 3

--- Packed vectors per pass of the value sum: each has three accumulators, one for each byte of a lane.
const VECTORS_PER_PASS = 1

--- The path of the module of the head size `lanes`, relative to the repository root.
const function sizePath(lanes: number): string
    return `src/ops/generated/attention_q8_unrolled_{lanes}.luau`
end

const PRELUDE = [[
--!native
--!optimize 2
--!nonstrict
-- Generated by tools/gen/attention_q8.luau. Do not edit, run lute run tools/gen/main.luau.
-- Causal attention over the vector layout of the Q8 KV cache, see `kvquant`, unrolled for one head size. It takes the
-- arguments of `attention.attend` with the packed keys and values and the scales in the shape.

const opsTypes = require("@src/ops/types")

]] .. vexp.TEXT

--- One position of `buffer.readvectorf32x3(b, base + off)`, with no `+ 0`.
const function read(b: string, base: string, off: number): string
    return `buffer.readvectorf32x3({b}, {emit.plus(base, off)})`
end

--- Writes the lines that take the packed vector `p` apart into `c`, `b` and `a`, the three bytes of its lanes as f32.
--- `parts` is how many of them the head needs, 1 to 3.
const function unpack(e: emit.Emitter, p: string, c: string, b: string, a: string, parts: number)
    emit.line(e, `const {c} = vector.floor({p})`)
    if parts > 1 then
        emit.line(e, `const x_{c} = ({p} - {c}) * 256`)
        emit.line(e, `const {b} = vector.floor(x_{c})`)
    end
    if parts > 2 then
        emit.line(e, `const {a} = (x_{c} - {b}) * 256`)
    end
end

--- The triples of the head that packed vector `v` holds, of `lanes`: 3 except for the last.
const function triplesOf(lanes: number, v: number): number
    return math.min(3, lanes - 3 * v)
end

--- The dot products of `R` positions starting at `j` with the query: writes their scores and takes the running max.
const function dots(e: emit.Emitter, lanes: number, R: number, row: number)
    const vectors = (lanes + 2) // 3
    emit.line(e, `const kb = kBase + j * {row}`)
    emit.line(e, "const ks = (row0 + j) * 4")
    for v = 0, vectors - 1 do
        const parts = triplesOf(lanes, v)
        const scoped = v > 0
        if scoped then
            emit.open(e, "do")
        end
        for k = 0, parts - 1 do
            emit.line(e, `const q{k} = {read("q", "qb", 12 * (3 * v + k))}`)
        end
        for r = 0, R - 1 do
            emit.line(e, `const p{r} = {read("keys", "kb", row * r + 12 * v)}`)
            unpack(e, `p{r}`, `c{r}`, `b{r}`, `a{r}`, parts)
            const terms: { string } = { `q0 * c{r}` }
            if parts > 1 then
                table.insert(terms, `q1 * b{r}`)
            end
            if parts > 2 then
                table.insert(terms, `q2 * a{r}`)
            end
            const sum = table.concat(terms, " + ")
            if v == 0 then
                emit.line(e, `local s{r} = {sum}`)
            else
                emit.line(e, `s{r} = s{r} + {sum}`)
            end
        end
        if scoped then
            emit.close(e)
        end
    end
    const names: { string } = {}
    for r = 0, R - 1 do
        emit.line(
            e,
            `const d{r} = ((s{r}.x + s{r}.y + s{r}.z) - off) * buffer.readf32(keyScales, {emit.plus("ks", 4 * r)}) * scale`
        )
        emit.line(e, `buffer.writef32(scores, {emit.plus("j * 4", 4 * r)}, d{r})`)
        table.insert(names, `d{r}`)
    end
    if R == 1 then
        emit.open(e, "if d0 > maxScore then")
        emit.line(e, "maxScore = d0")
        emit.close(e)
    else
        emit.line(e, `maxScore = math.max(maxScore, {table.concat(names, ", ")})`)
    end
end

--- The sum over the positions of the weights times the values for packed vectors `v` to `v + n - 1`, written as the
--- output lanes of their triples.
const function mix(e: emit.Emitter, lanes: number, v0: number, n: number, row: number)
    const accs: { string } = {}
    const zeros: { string } = {}
    for k = 0, n - 1 do
        for _, name in { "c", "b", "a" } do
            if (name == "c") or (name == "b" and triplesOf(lanes, v0 + k) > 1) or triplesOf(lanes, v0 + k) > 2 then
                table.insert(accs, `{name}{k}`)
                table.insert(zeros, "vector.zero")
            end
        end
    end
    emit.open(e, "do")
    emit.line(e, `local {table.concat(accs, ", ")} = {table.concat(zeros, ", ")}`)
    const function pass(count: number, header: string)
        emit.open(e, header)
        emit.line(e, `const vb = {emit.plus(`vBase + j * {row}`, 12 * v0)}`)
        for s = 0, count - 1 do
            emit.line(e, `const w{s} = buffer.readf32(scores, {emit.plus("j * 4", 4 * s)})`)
        end
        for k = 0, n - 1 do
            const parts = triplesOf(lanes, v0 + k)
            for s = 0, count - 1 do
                emit.line(e, `const p{k}_{s} = {read("values", "vb", row * s + 12 * k)}`)
                unpack(e, `p{k}_{s}`, `uc{k}_{s}`, `ub{k}_{s}`, `ua{k}_{s}`, parts)
            end
            for part = 1, parts do
                const name = ({ "c", "b", "a" })[part]
                const letter = ({ "uc", "ub", "ua" })[part]
                const terms: { string } = {}
                for s = 0, count - 1 do
                    table.insert(terms, `{letter}{k}_{s} * w{s}`)
                end
                if count == 4 then
                    emit.line(e, `{name}{k} = {name}{k} + ({terms[1]} + {terms[2]}) + ({terms[3]} + {terms[4]})`)
                else
                    emit.line(e, `{name}{k} = {name}{k} + {table.concat(terms, " + ")}`)
                end
            end
        end
        emit.close(e)
    end
    pass(POSITIONS, `for j = 0, n4 - 1, {POSITIONS} do`)
    pass(1, "for j = n4, n - 1 do")
    for k = 0, n - 1 do
        const parts = triplesOf(lanes, v0 + k)
        for part = 1, parts do
            const name = ({ "c", "b", "a" })[part]
            const triple = 3 * (v0 + k) + part - 1
            const d = 3 * triple
            const at = emit.plus("ob", 4 * d)
            if triple == lanes - 1 then
                emit.line(e, `storeEdge(out, ({name}{k} - woff) * inv, {at}, hd - {d})`)
            else
                emit.line(e, `const o{name}{k} = ({name}{k} - woff) * inv`)
                emit.line(e, `buffer.writef32(out, {at}, o{name}{k}.x)`)
                emit.line(e, `buffer.writef32(out, {emit.plus("ob", 4 * d + 4)}, o{name}{k}.y)`)
                emit.line(e, `buffer.writef32(out, {emit.plus("ob", 4 * d + 8)}, o{name}{k}.z)`)
            end
        end
    end
    emit.close(e)
end

--- The text of the function for heads of `lanes` lanes. A `stage` of "dots" or "softmax" ends each head after the dot
--- products or after the softmax, for `tools/bench/attention_profile.luau` to time the parts by difference.
const function render(lanes: number, stage: string?): string
    const vectors = (lanes + 2) // 3
    const row = vectors * 12
    const e = emit.new()
    emit.open(
        e,
        `const function attend{lanes}(s: opsTypes.Shape, q: buffer, tokens: number, keys: buffer, values: buffer, pos0: number, out: buffer, outStride: number, scores: buffer, _acc: \{ number })`
    )
    emit.line(e, "const keyScales, valueScales = s.keyScales :: buffer, s.valueScales :: buffer")
    emit.line(e, "const hd, context = s.headDim, s.context")
    emit.line(e, "const group, headBase, kvBase = s.group, s.headBase, s.kvBase")
    emit.line(e, "const scale = s.scale")
    emit.open(e, "for t = 0, tokens - 1 do")
    emit.line(e, "const last = pos0 + t")
    emit.line(e, "local first = 0")
    emit.open(e, "if s.window ~= nil and last - s.window + 1 > 0 then")
    emit.line(e, "first = last - s.window + 1")
    emit.close(e)
    emit.line(e, "const n = last - first + 1")
    emit.line(e, `const n4 = n - n % {POSITIONS}`)
    emit.line(e, "const nt = n // 3")
    emit.open(e, "for h = 0, s.heads - 1 do")
    emit.line(e, "const g = (headBase + h) // group - kvBase")
    emit.line(e, `const qb = ((t * s.heads) + h) * {lanes * 12}`)
    emit.line(e, "const row0 = g * context + first")
    emit.line(e, `const kBase = row0 * {row}`)
    emit.line(e, "local sq = vector.zero")
    for i = 0, lanes - 1 do
        emit.line(e, `sq = sq + {read("q", "qb", 12 * i)}`)
    end
    emit.line(e, "const off = 128 * (sq.x + sq.y + sq.z)")
    emit.line(e, "local maxScore = -math.huge")
    emit.open(e, `for j = 0, n4 - 1, {POSITIONS} do`)
    dots(e, lanes, POSITIONS, row)
    emit.close(e)
    emit.open(e, "for j = n4, n - 1 do")
    dots(e, lanes, 1, row)
    emit.close(e)
    if stage == "dots" then
        emit.line(e, "if maxScore == maxScore then continue end")
    end
    emit.line(e, "const mv = vector.create(maxScore, maxScore, maxScore)")
    emit.line(e, "const vs = row0 * 4")
    emit.line(e, "local tv, wv = vector.zero, vector.zero")
    emit.open(e, "for i = 0, nt * 12 - 1, 12 do")
    emit.line(e, "const w = vexp(buffer.readvectorf32x3(scores, i) - mv)")
    emit.line(e, "tv = tv + w")
    emit.line(e, "const ws = w * buffer.readvectorf32x3(valueScales, vs + i)")
    emit.line(e, "buffer.writevectorf32x3(scores, i, ws)")
    emit.line(e, "wv = wv + ws")
    emit.close(e)
    emit.line(e, "local total, wsum = tv.x + tv.y + tv.z, wv.x + wv.y + wv.z")
    emit.open(e, "for j = nt * 3, n - 1 do")
    emit.line(e, "const w = math.exp(buffer.readf32(scores, j * 4) - maxScore)")
    emit.line(e, "const ws = w * buffer.readf32(valueScales, vs + j * 4)")
    emit.line(e, "buffer.writef32(scores, j * 4, ws)")
    emit.line(e, "total += w")
    emit.line(e, "wsum += ws")
    emit.close(e)
    emit.line(e, "const inv = 1 / total")
    emit.line(e, "const woff = vector.create(128 * wsum, 128 * wsum, 128 * wsum)")
    if stage == "softmax" then
        emit.line(e, "if inv == inv then continue end")
    end
    emit.line(e, "const ob = (t * outStride + h * hd) * 4")
    emit.line(e, `const vBase = row0 * {row}`)
    local v = 0
    while v < vectors do
        const n = math.min(VECTORS_PER_PASS, vectors - v)
        mix(e, lanes, v, n, row)
        v += n
    end
    emit.close(e)
    emit.close(e)
    emit.close(e)
    return emit.text(e)
end

--- The text of the module of the head size `lanes`, which returns its function. A `stage` ends each head early, see
--- `render`.
const function renderSize(lanes: number, stage: string?): string
    return table.concat({ PRELUDE, render(lanes, stage), `return attend{lanes}` }, "\n") .. "\n"
end

--- The text of every head size in one module with `byLanes`, which `tools/bench/attention_profile.luau` loads for its
--- stage functions.
const function renderModule(stage: string?): string
    const parts: { string } = { PRELUDE }
    for _, lanes in LANES do
        table.insert(parts, render(lanes, stage))
    end
    table.insert(parts, "return {")
    table.insert(parts, "    byLanes = {")
    for _, lanes in LANES do
        table.insert(parts, `        [{lanes}] = attend{lanes},`)
    end
    table.insert(parts, "    },")
    table.insert(parts, "}")
    return table.concat(parts, "\n") .. "\n"
end

return {
    LANES = LANES,
    sizePath = sizePath,
    renderSize = renderSize,
    renderModule = renderModule,
}
