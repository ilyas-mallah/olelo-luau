-- Renders the generated kernel modules from `tiles.luau`. Pure text in, text out, so tests can call it.

const attention = require("./attention")
const floatVector = require("./families/float_vector")
const floatScalar = require("./families/float_scalar")
const q4 = require("./families/q4")
const q4p = require("./families/q4p")
const q8 = require("./families/q8")
const q8p = require("./families/q8p")
const q8v = require("./families/q8v")
const tile = require("./tile")
const tiles = require("./tiles")

--- Bumped when the shape of the generated output changes. Written into every generated module's header.
const GENERATOR_VERSION = 1

--- What a family offers: the columns a pass covers and the text of a kernel.
type Family = {
    kstep: (t: tile.Tile) -> number,
    render: (t: tile.Tile) -> string,
}

const FAMILIES: { [string]: Family } = {
    float_vector = floatVector,
    float_scalar = floatScalar,
    q8 = q8,
    q8p = q8p,
    q8v = q8v,
    q4 = q4,
    q4p = q4p,
}

--- The path of a generated module relative to the repository root.
const function pathOf(spec: tile.ModuleSpec): string
    return `src/kernels/generated/{spec.file}.luau`
end

--- The full text of one generated module.
const function renderModule(spec: tile.ModuleSpec): string
    const family = FAMILIES[spec.family]
    assert(family ~= nil, `unknown family {spec.family}`)
    const parts: { string } = {
        "--!native",
        "--!optimize 2",
        `-- Generated by tools/gen, generator version {GENERATOR_VERSION}. Do not edit, run lute run tools/gen/main.luau.`,
        `-- {spec.summary}.`,
        "",
        'const kernelsTypes = require("@src/kernels/types")',
        "",
    }
    if spec.strictness == "nonstrict" then
        table.insert(parts, 3, "--!nonstrict")
    end
    const entries: { string } = {}
    for _, t in spec.tiles do
        table.insert(parts, family.render(t))
        const fmt = if t.fmt then `, fmt = "{t.fmt}"` else ""
        const src = if t.src then `, src = "{t.src}"` else ""
        table.insert(
            entries,
            `        \{ name = "{t.name}", R = {t.R}, S = {t.S}, U = {t.U}, kstep = {family.kstep(t)}, order = "{t.order}"{fmt}{src}, fn = {t.name} },`
        )
    end
    table.insert(parts, "const generated: kernelsTypes.Module = {")
    table.insert(parts, `    version = {GENERATOR_VERSION},`)
    table.insert(parts, `    family = "{spec.family}",`)
    table.insert(parts, `    format = "{spec.format}",`)
    table.insert(parts, `    layout = "{spec.layout}",`)
    table.insert(parts, `    activation = "{spec.activation}",`)
    table.insert(parts, "    tiles = {")
    for _, entry in entries do
        table.insert(parts, entry)
    end
    table.insert(parts, "    },")
    table.insert(parts, "}")
    table.insert(parts, "return generated")
    return table.concat(parts, "\n") .. "\n"
end

--- Every generated module: its path and its text, in the order of `tiles.luau`.
const function renderAll(): { { path: string, text: string } }
    const out = {}
    for _, spec in tiles.modules do
        table.insert(out, { path = pathOf(spec), text = renderModule(spec) })
    end
    return out
end

--- The generated modules that are not kernels: their path and text.
const function renderOps(): { { path: string, text: string } }
    return attention.renderFiles()
end

--- Every generated file, kernels first.
const function renderEvery(): { { path: string, text: string } }
    const files = renderAll()
    for _, file in renderOps() do
        table.insert(files, file)
    end
    return files
end

return {
    GENERATOR_VERSION = GENERATOR_VERSION,
    pathOf = pathOf,
    renderModule = renderModule,
    renderAll = renderAll,
    renderOps = renderOps,
    renderEvery = renderEvery,
}
