--!native
--!optimize 2
--!nonstrict
-- Generated by tools/gen/attention_q8.luau. Do not edit, run lute run tools/gen/main.luau.
-- Causal attention over the vector layout of the Q8 KV cache, see `kvquant`, unrolled for one head size. It takes the
-- arguments of `attention.attend` with the packed keys and values and the scales in the shape.

const opsTypes = require("@src/ops/types")

const EXPLO = vector.create(-32, -32, -32)
const E2 = vector.create(1 / 2, 1 / 2, 1 / 2)
const E3 = vector.create(1 / 6, 1 / 6, 1 / 6)
const E4 = vector.create(1 / 24, 1 / 24, 1 / 24)
const E5 = vector.create(1 / 120, 1 / 120, 1 / 120)
const E6 = vector.create(1 / 720, 1 / 720, 1 / 720)
const E7 = vector.create(1 / 5040, 1 / 5040, 1 / 5040)
const E8 = vector.create(1 / 40320, 1 / 40320, 1 / 40320)
const ONE = vector.one

--- exp(x) of three lanes for x <= 0, clamped at -32: the Taylor polynomial of degree 8 at x / 64, then six squarings.
--- The relative error is about 5e-6.
const function vexp(x: vector): vector
    const t = vector.max(x, EXPLO) * 0.015625
    local p = E8 * t + E7
    p = p * t + E6
    p = p * t + E5
    p = p * t + E4
    p = p * t + E3
    p = p * t + E2
    p = p * t + ONE
    p = p * t + ONE
    p = p * p
    p = p * p
    p = p * p
    p = p * p
    p = p * p
    return p * p
end

--- Writes the lane at `at` of `out` with only the `left` values the head still has, 1 to 3.
const function storeEdge(out: buffer, v: vector, at: number, left: number)
    buffer.writef32(out, at, v.x)
    if left > 1 then
        buffer.writef32(out, at + 4, v.y)
    end
    if left > 2 then
        buffer.writef32(out, at + 8, v.z)
    end
end

const function attend4(s: opsTypes.Shape, q: buffer, tokens: number, keys: buffer, values: buffer, pos0: number, out: buffer, outStride: number, scores: buffer, _acc: { number })
    const keyScales, valueScales = s.keyScales :: buffer, s.valueScales :: buffer
    const hd, context = s.headDim, s.context
    const group, headBase, kvBase = s.group, s.headBase, s.kvBase
    const scale = s.scale
    for t = 0, tokens - 1 do
        const last = pos0 + t
        local first = 0
        if s.window ~= nil and last - s.window + 1 > 0 then
            first = last - s.window + 1
        end
        const n = last - first + 1
        const n4 = n - n % 3
        const nt = n // 3
        for h = 0, s.heads - 1 do
            const g = (headBase + h) // group - kvBase
            const qb = ((t * s.heads) + h) * 48
            const row0 = g * context + first
            const kBase = row0 * 24
            local sq = vector.zero
            sq = sq + buffer.readvectorf32x3(q, qb)
            sq = sq + buffer.readvectorf32x3(q, qb + 12)
            sq = sq + buffer.readvectorf32x3(q, qb + 24)
            sq = sq + buffer.readvectorf32x3(q, qb + 36)
            const off = 128 * (sq.x + sq.y + sq.z)
            local maxScore = -math.huge
            for j = 0, n4 - 1, 3 do
                const kb = kBase + j * 24
                const ks = (row0 + j) * 4
                const q0 = buffer.readvectorf32x3(q, qb)
                const q1 = buffer.readvectorf32x3(q, qb + 12)
                const q2 = buffer.readvectorf32x3(q, qb + 24)
                const p0 = buffer.readvectorf32x3(keys, kb)
                const c0 = vector.floor(p0)
                const x_c0 = (p0 - c0) * 256
                const b0 = vector.floor(x_c0)
                const a0 = (x_c0 - b0) * 256
                local s0 = q0 * c0 + q1 * b0 + q2 * a0
                const p1 = buffer.readvectorf32x3(keys, kb + 24)
                const c1 = vector.floor(p1)
                const x_c1 = (p1 - c1) * 256
                const b1 = vector.floor(x_c1)
                const a1 = (x_c1 - b1) * 256
                local s1 = q0 * c1 + q1 * b1 + q2 * a1
                const p2 = buffer.readvectorf32x3(keys, kb + 48)
                const c2 = vector.floor(p2)
                const x_c2 = (p2 - c2) * 256
                const b2 = vector.floor(x_c2)
                const a2 = (x_c2 - b2) * 256
                local s2 = q0 * c2 + q1 * b2 + q2 * a2
                do
                    const q0 = buffer.readvectorf32x3(q, qb + 36)
                    const p0 = buffer.readvectorf32x3(keys, kb + 12)
                    const c0 = vector.floor(p0)
                    s0 = s0 + q0 * c0
                    const p1 = buffer.readvectorf32x3(keys, kb + 36)
                    const c1 = vector.floor(p1)
                    s1 = s1 + q0 * c1
                    const p2 = buffer.readvectorf32x3(keys, kb + 60)
                    const c2 = vector.floor(p2)
                    s2 = s2 + q0 * c2
                end
                const d0 = ((s0.x + s0.y + s0.z) - off) * buffer.readf32(keyScales, ks) * scale
                buffer.writef32(scores, j * 4, d0)
                const d1 = ((s1.x + s1.y + s1.z) - off) * buffer.readf32(keyScales, ks + 4) * scale
                buffer.writef32(scores, j * 4 + 4, d1)
                const d2 = ((s2.x + s2.y + s2.z) - off) * buffer.readf32(keyScales, ks + 8) * scale
                buffer.writef32(scores, j * 4 + 8, d2)
                maxScore = math.max(maxScore, d0, d1, d2)
            end
            for j = n4, n - 1 do
                const kb = kBase + j * 24
                const ks = (row0 + j) * 4
                const q0 = buffer.readvectorf32x3(q, qb)
                const q1 = buffer.readvectorf32x3(q, qb + 12)
                const q2 = buffer.readvectorf32x3(q, qb + 24)
                const p0 = buffer.readvectorf32x3(keys, kb)
                const c0 = vector.floor(p0)
                const x_c0 = (p0 - c0) * 256
                const b0 = vector.floor(x_c0)
                const a0 = (x_c0 - b0) * 256
                local s0 = q0 * c0 + q1 * b0 + q2 * a0
                do
                    const q0 = buffer.readvectorf32x3(q, qb + 36)
                    const p0 = buffer.readvectorf32x3(keys, kb + 12)
                    const c0 = vector.floor(p0)
                    s0 = s0 + q0 * c0
                end
                const d0 = ((s0.x + s0.y + s0.z) - off) * buffer.readf32(keyScales, ks) * scale
                buffer.writef32(scores, j * 4, d0)
                if d0 > maxScore then
                    maxScore = d0
                end
            end
            const mv = vector.create(maxScore, maxScore, maxScore)
            const vs = row0 * 4
            local tv, wv = vector.zero, vector.zero
            for i = 0, nt * 12 - 1, 12 do
                const w = vexp(buffer.readvectorf32x3(scores, i) - mv)
                tv = tv + w
                const ws = w * buffer.readvectorf32x3(valueScales, vs + i)
                buffer.writevectorf32x3(scores, i, ws)
                wv = wv + ws
            end
            local total, wsum = tv.x + tv.y + tv.z, wv.x + wv.y + wv.z
            for j = nt * 3, n - 1 do
                const w = math.exp(buffer.readf32(scores, j * 4) - maxScore)
                const ws = w * buffer.readf32(valueScales, vs + j * 4)
                buffer.writef32(scores, j * 4, ws)
                total += w
                wsum += ws
            end
            const inv = 1 / total
            const woff = vector.create(128 * wsum, 128 * wsum, 128 * wsum)
            const ob = (t * outStride + h * hd) * 4
            const vBase = row0 * 24
            do
                local c0, b0, a0 = vector.zero, vector.zero, vector.zero
                for j = 0, n4 - 1, 3 do
                    const vb = vBase + j * 24
                    const w0 = buffer.readf32(scores, j * 4)
                    const w1 = buffer.readf32(scores, j * 4 + 4)
                    const w2 = buffer.readf32(scores, j * 4 + 8)
                    const p0_0 = buffer.readvectorf32x3(values, vb)
                    const uc0_0 = vector.floor(p0_0)
                    const x_uc0_0 = (p0_0 - uc0_0) * 256
                    const ub0_0 = vector.floor(x_uc0_0)
                    const ua0_0 = (x_uc0_0 - ub0_0) * 256
                    const p0_1 = buffer.readvectorf32x3(values, vb + 24)
                    const uc0_1 = vector.floor(p0_1)
                    const x_uc0_1 = (p0_1 - uc0_1) * 256
                    const ub0_1 = vector.floor(x_uc0_1)
                    const ua0_1 = (x_uc0_1 - ub0_1) * 256
                    const p0_2 = buffer.readvectorf32x3(values, vb + 48)
                    const uc0_2 = vector.floor(p0_2)
                    const x_uc0_2 = (p0_2 - uc0_2) * 256
                    const ub0_2 = vector.floor(x_uc0_2)
                    const ua0_2 = (x_uc0_2 - ub0_2) * 256
                    c0 = c0 + uc0_0 * w0 + uc0_1 * w1 + uc0_2 * w2
                    b0 = b0 + ub0_0 * w0 + ub0_1 * w1 + ub0_2 * w2
                    a0 = a0 + ua0_0 * w0 + ua0_1 * w1 + ua0_2 * w2
                end
                for j = n4, n - 1 do
                    const vb = vBase + j * 24
                    const w0 = buffer.readf32(scores, j * 4)
                    const p0_0 = buffer.readvectorf32x3(values, vb)
                    const uc0_0 = vector.floor(p0_0)
                    const x_uc0_0 = (p0_0 - uc0_0) * 256
                    const ub0_0 = vector.floor(x_uc0_0)
                    const ua0_0 = (x_uc0_0 - ub0_0) * 256
                    c0 = c0 + uc0_0 * w0
                    b0 = b0 + ub0_0 * w0
                    a0 = a0 + ua0_0 * w0
                end
                const oc0 = (c0 - woff) * inv
                buffer.writef32(out, ob, oc0.x)
                buffer.writef32(out, ob + 4, oc0.y)
                buffer.writef32(out, ob + 8, oc0.z)
                const ob0 = (b0 - woff) * inv
                buffer.writef32(out, ob + 12, ob0.x)
                buffer.writef32(out, ob + 16, ob0.y)
                buffer.writef32(out, ob + 20, ob0.z)
                const oa0 = (a0 - woff) * inv
                buffer.writef32(out, ob + 24, oa0.x)
                buffer.writef32(out, ob + 28, oa0.y)
                buffer.writef32(out, ob + 32, oa0.z)
            end
            do
                local c0 = vector.zero
                for j = 0, n4 - 1, 3 do
                    const vb = vBase + j * 24 + 12
                    const w0 = buffer.readf32(scores, j * 4)
                    const w1 = buffer.readf32(scores, j * 4 + 4)
                    const w2 = buffer.readf32(scores, j * 4 + 8)
                    const p0_0 = buffer.readvectorf32x3(values, vb)
                    const uc0_0 = vector.floor(p0_0)
                    const p0_1 = buffer.readvectorf32x3(values, vb + 24)
                    const uc0_1 = vector.floor(p0_1)
                    const p0_2 = buffer.readvectorf32x3(values, vb + 48)
                    const uc0_2 = vector.floor(p0_2)
                    c0 = c0 + uc0_0 * w0 + uc0_1 * w1 + uc0_2 * w2
                end
                for j = n4, n - 1 do
                    const vb = vBase + j * 24 + 12
                    const w0 = buffer.readf32(scores, j * 4)
                    const p0_0 = buffer.readvectorf32x3(values, vb)
                    const uc0_0 = vector.floor(p0_0)
                    c0 = c0 + uc0_0 * w0
                end
                storeEdge(out, (c0 - woff) * inv, ob + 36, hd - 9)
            end
        end
    end
end

return attend4
