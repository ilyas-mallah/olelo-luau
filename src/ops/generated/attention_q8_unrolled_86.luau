                    const uc0_2 = vector.floor(p0_2)
                    const x_uc0_2 = (p0_2 - uc0_2) * 256
                    const ub0_2 = vector.floor(x_uc0_2)
                    const ua0_2 = (x_uc0_2 - ub0_2) * 256
                    c0 = c0 + uc0_0 * w0 + uc0_1 * w1 + uc0_2 * w2
                    b0 = b0 + ub0_0 * w0 + ub0_1 * w1 + ub0_2 * w2
                    a0 = a0 + ua0_0 * w0 + ua0_1 * w1 + ua0_2 * w2
                end
                for j = n4, n - 1 do
                    const vb = vBase + j * 348 + 324
                    const w0 = buffer.readf32(scores, j * 4)
                    const p0_0 = buffer.readvectorf32x3(values, vb)
                    const uc0_0 = vector.floor(p0_0)
                    const x_uc0_0 = (p0_0 - uc0_0) * 256
                    const ub0_0 = vector.floor(x_uc0_0)
                    const ua0_0 = (x_uc0_0 - ub0_0) * 256
                    c0 = c0 + uc0_0 * w0
                    b0 = b0 + ub0_0 * w0
                    a0 = a0 + ua0_0 * w0
                end
                const oc0 = (c0 - woff) * inv
                buffer.writef32(out, ob + 972, oc0.x)
                buffer.writef32(out, ob + 976, oc0.y)
                buffer.writef32(out, ob + 980, oc0.z)
                const ob0 = (b0 - woff) * inv
                buffer.writef32(out, ob + 984, ob0.x)
                buffer.writef32(out, ob + 988, ob0.y)
                buffer.writef32(out, ob + 992, ob0.z)
                const oa0 = (a0 - woff) * inv
                buffer.writef32(out, ob + 996, oa0.x)
                buffer.writef32(out, ob + 1000, oa0.y)
                buffer.writef32(out, ob + 1004, oa0.z)
            end
            do
                local c0, b0 = vector.zero, vector.zero
                for j = 0, n4 - 1, 3 do
                    const vb = vBase + j * 348 + 336
                    const w0 = buffer.readf32(scores, j * 4)
                    const w1 = buffer.readf32(scores, j * 4 + 4)
                    const w2 = buffer.readf32(scores, j * 4 + 8)
                    const p0_0 = buffer.readvectorf32x3(values, vb)
                    const uc0_0 = vector.floor(p0_0)
                    const x_uc0_0 = (p0_0 - uc0_0) * 256
                    const ub0_0 = vector.floor(x_uc0_0)
                    const p0_1 = buffer.readvectorf32x3(values, vb + 348)
                    const uc0_1 = vector.floor(p0_1)
                    const x_uc0_1 = (p0_1 - uc0_1) * 256
                    const ub0_1 = vector.floor(x_uc0_1)
                    const p0_2 = buffer.readvectorf32x3(values, vb + 696)
                    const uc0_2 = vector.floor(p0_2)
                    const x_uc0_2 = (p0_2 - uc0_2) * 256
                    const ub0_2 = vector.floor(x_uc0_2)
                    c0 = c0 + uc0_0 * w0 + uc0_1 * w1 + uc0_2 * w2
                    b0 = b0 + ub0_0 * w0 + ub0_1 * w1 + ub0_2 * w2
                end
                for j = n4, n - 1 do
                    const vb = vBase + j * 348 + 336
                    const w0 = buffer.readf32(scores, j * 4)
                    const p0_0 = buffer.readvectorf32x3(values, vb)
                    const uc0_0 = vector.floor(p0_0)
                    const x_uc0_0 = (p0_0 - uc0_0) * 256
                    const ub0_0 = vector.floor(x_uc0_0)
                    c0 = c0 + uc0_0 * w0
                    b0 = b0 + ub0_0 * w0
                end
                const oc0 = (c0 - woff) * inv
                buffer.writef32(out, ob + 1008, oc0.x)
                buffer.writef32(out, ob + 1012, oc0.y)
                buffer.writef32(out, ob + 1016, oc0.z)
                storeEdge(out, (b0 - woff) * inv, ob + 1020, hd - 255)
            end
        end
    end
end

return attend86
