--!native
--!optimize 2
--!nonstrict
-- Generated by tools/gen/attention.luau. Do not edit, run lute run tools/gen/main.luau.
-- Causal attention like `attention_vector`, unrolled for one head size.

const opsTypes = require("@src/ops/types")

const EXPLO = vector.create(-32, -32, -32)
const E2 = vector.create(1 / 2, 1 / 2, 1 / 2)
const E3 = vector.create(1 / 6, 1 / 6, 1 / 6)
const E4 = vector.create(1 / 24, 1 / 24, 1 / 24)
const E5 = vector.create(1 / 120, 1 / 120, 1 / 120)
const E6 = vector.create(1 / 720, 1 / 720, 1 / 720)
const E7 = vector.create(1 / 5040, 1 / 5040, 1 / 5040)
const E8 = vector.create(1 / 40320, 1 / 40320, 1 / 40320)
const ONE = vector.one

--- exp(x) of three lanes for x <= 0, clamped at -32: the Taylor polynomial of degree 8 at x / 64, then six squarings.
--- The relative error is about 5e-6.
const function vexp(x: vector): vector
    const t = vector.max(x, EXPLO) * 0.015625
    local p = E8 * t + E7
    p = p * t + E6
    p = p * t + E5
    p = p * t + E4
    p = p * t + E3
    p = p * t + E2
    p = p * t + ONE
    p = p * t + ONE
    p = p * p
    p = p * p
    p = p * p
    p = p * p
    p = p * p
    return p * p
end

--- Writes the lane at `at` of `out` with only the `left` values the head still has, 1 to 3.
const function storeEdge(out: buffer, v: vector, at: number, left: number)
    buffer.writef32(out, at, v.x)
    if left > 1 then
        buffer.writef32(out, at + 4, v.y)
    end
    if left > 2 then
        buffer.writef32(out, at + 8, v.z)
    end
end

const function attend4(s: opsTypes.Shape, q: buffer, tokens: number, keys: buffer, values: buffer, pos0: number, out: buffer, outStride: number, scores: buffer, _acc: { number })
    const hd, context = s.headDim, s.context
    const group, headBase, kvBase = s.group, s.headBase, s.kvBase
    const scale = s.scale
    const rowBytes = 48
    for t = 0, tokens - 1 do
        const last = pos0 + t
        local first = 0
        if s.window ~= nil and last - s.window + 1 > 0 then
            first = last - s.window + 1
        end
        const n = last - first + 1
        const n4 = n - n % 4
        const nt = n // 3
        for h = 0, s.heads - 1 do
            const g = (headBase + h) // group - kvBase
            const qb = ((t * s.heads) + h) * rowBytes
            const cacheBase = g * context * rowBytes
            local maxScore = -math.huge
            for j = 0, n4 - 1, 4 do
                const kb = cacheBase + (first + j) * 48
                const q0 = buffer.readvectorf32x3(q, qb)
                local a0 = q0 * buffer.readvectorf32x3(keys, kb)
                local a1 = q0 * buffer.readvectorf32x3(keys, kb + 48)
                local a2 = q0 * buffer.readvectorf32x3(keys, kb + 96)
                local a3 = q0 * buffer.readvectorf32x3(keys, kb + 144)
                do
                    const q1 = buffer.readvectorf32x3(q, qb + 12)
                    a0 = a0 + q1 * buffer.readvectorf32x3(keys, kb + 12)
                    a1 = a1 + q1 * buffer.readvectorf32x3(keys, kb + 60)
                    a2 = a2 + q1 * buffer.readvectorf32x3(keys, kb + 108)
                    a3 = a3 + q1 * buffer.readvectorf32x3(keys, kb + 156)
                end
                do
                    const q2 = buffer.readvectorf32x3(q, qb + 24)
                    a0 = a0 + q2 * buffer.readvectorf32x3(keys, kb + 24)
                    a1 = a1 + q2 * buffer.readvectorf32x3(keys, kb + 72)
                    a2 = a2 + q2 * buffer.readvectorf32x3(keys, kb + 120)
                    a3 = a3 + q2 * buffer.readvectorf32x3(keys, kb + 168)
                end
                do
                    const q3 = buffer.readvectorf32x3(q, qb + 36)
                    a0 = a0 + q3 * buffer.readvectorf32x3(keys, kb + 36)
                    a1 = a1 + q3 * buffer.readvectorf32x3(keys, kb + 84)
                    a2 = a2 + q3 * buffer.readvectorf32x3(keys, kb + 132)
                    a3 = a3 + q3 * buffer.readvectorf32x3(keys, kb + 180)
                end
                const d0 = (a0.x + a0.y + a0.z) * scale
                buffer.writef32(scores, j * 4, d0)
                const d1 = (a1.x + a1.y + a1.z) * scale
                buffer.writef32(scores, j * 4 + 4, d1)
                const d2 = (a2.x + a2.y + a2.z) * scale
                buffer.writef32(scores, j * 4 + 8, d2)
                const d3 = (a3.x + a3.y + a3.z) * scale
                buffer.writef32(scores, j * 4 + 12, d3)
                maxScore = math.max(maxScore, d0, d1, d2, d3)
            end
            for j = n4, n - 1 do
                const kb = cacheBase + (first + j) * 48
                const q0 = buffer.readvectorf32x3(q, qb)
                local a0 = q0 * buffer.readvectorf32x3(keys, kb)
                do
                    const q1 = buffer.readvectorf32x3(q, qb + 12)
                    a0 = a0 + q1 * buffer.readvectorf32x3(keys, kb + 12)
                end
                do
                    const q2 = buffer.readvectorf32x3(q, qb + 24)
                    a0 = a0 + q2 * buffer.readvectorf32x3(keys, kb + 24)
                end
                do
                    const q3 = buffer.readvectorf32x3(q, qb + 36)
                    a0 = a0 + q3 * buffer.readvectorf32x3(keys, kb + 36)
                end
                const d0 = (a0.x + a0.y + a0.z) * scale
                buffer.writef32(scores, j * 4, d0)
                if d0 > maxScore then
                    maxScore = d0
                end
            end
            const mv = vector.create(maxScore, maxScore, maxScore)
            local tv = vector.zero
            for i = 0, nt * 12 - 1, 12 do
                const w = vexp(buffer.readvectorf32x3(scores, i) - mv)
                buffer.writevectorf32x3(scores, i, w)
                tv = tv + w
            end
            local total = tv.x + tv.y + tv.z
            for j = nt * 3, n - 1 do
                const w = math.exp(buffer.readf32(scores, j * 4) - maxScore)
                buffer.writef32(scores, j * 4, w)
                total += w
            end
            const inv = 1 / total
            const ob = (t * outStride + h * hd) * 4
            const vBase = cacheBase + first * rowBytes
            do
                local v0, v1, v2, v3 = vector.zero, vector.zero, vector.zero, vector.zero
                for j = 0, n4 - 1, 4 do
                    const vb = vBase + j * 48
                    const p0 = buffer.readf32(scores, j * 4)
                    const p1 = buffer.readf32(scores, j * 4 + 4)
                    const p2 = buffer.readf32(scores, j * 4 + 8)
                    const p3 = buffer.readf32(scores, j * 4 + 12)
                    v0 = v0 + (buffer.readvectorf32x3(values, vb) * p0 + buffer.readvectorf32x3(values, vb + 48) * p1) + (buffer.readvectorf32x3(values, vb + 96) * p2 + buffer.readvectorf32x3(values, vb + 144) * p3)
                    v1 = v1 + (buffer.readvectorf32x3(values, vb + 12) * p0 + buffer.readvectorf32x3(values, vb + 60) * p1) + (buffer.readvectorf32x3(values, vb + 108) * p2 + buffer.readvectorf32x3(values, vb + 156) * p3)
                    v2 = v2 + (buffer.readvectorf32x3(values, vb + 24) * p0 + buffer.readvectorf32x3(values, vb + 72) * p1) + (buffer.readvectorf32x3(values, vb + 120) * p2 + buffer.readvectorf32x3(values, vb + 168) * p3)
                    v3 = v3 + (buffer.readvectorf32x3(values, vb + 36) * p0 + buffer.readvectorf32x3(values, vb + 84) * p1) + (buffer.readvectorf32x3(values, vb + 132) * p2 + buffer.readvectorf32x3(values, vb + 180) * p3)
                end
                for j = n4, n - 1 do
                    const vb = vBase + j * 48
                    const p = buffer.readf32(scores, j * 4)
                    v0 = v0 + buffer.readvectorf32x3(values, vb) * p
                    v1 = v1 + buffer.readvectorf32x3(values, vb + 12) * p
                    v2 = v2 + buffer.readvectorf32x3(values, vb + 24) * p
                    v3 = v3 + buffer.readvectorf32x3(values, vb + 36) * p
                end
                const w0 = v0 * inv
                buffer.writef32(out, ob, w0.x)
                buffer.writef32(out, ob + 4, w0.y)
                buffer.writef32(out, ob + 8, w0.z)
                const w1 = v1 * inv
                buffer.writef32(out, ob + 12, w1.x)
                buffer.writef32(out, ob + 16, w1.y)
                buffer.writef32(out, ob + 20, w1.z)
                const w2 = v2 * inv
                buffer.writef32(out, ob + 24, w2.x)
                buffer.writef32(out, ob + 28, w2.y)
                buffer.writef32(out, ob + 32, w2.z)
                storeEdge(out, v3 * inv, ob + 36, hd - 9)
            end
        end
    end
end

return attend4
