const harness = require("@tests/harness")
const json = require("@src/util/json")

return function(h: harness.Harness)
    h.case("scalars", function()
        h.equal(json.decode("42"), 42)
        h.equal(json.decode("-1.5e-3"), -0.0015)
        h.equal(json.decode("1e-05"), 1e-5)
        h.equal(json.decode("true"), true)
        h.equal(json.decode("false"), false)
        h.equal(json.decode("null"), nil)
        h.equal(json.decode(' "text" '), "text")
    end)

    h.case("strings with escapes", function()
        h.equal(json.decode([["a\nb\t\"c\\d\/"]]), 'a\nb\t"c\\d/')
        h.equal(json.decode([["é你"]]), "é你")
        h.equal(json.decode([["😀"]]), "😀")
        h.equal(json.decode('"é😀 raw"'), "é😀 raw")
    end)

    h.case("nested arrays and objects", function()
        const value = json.decode('{"a":[1,2,{"b":[]}],"c":{},"d":"x", "e" : [ true , null ]}')
        h.equal(value.a[2], 2)
        h.equal(#value.a[3].b, 0)
        h.equal(next(value.c), nil)
        h.equal(value.d, "x")
        h.equal(value.e[1], true)
    end)

    h.case("rejects bad input with a position", function()
        h.fails(function()
            json.decode("{")
        end)
        h.fails(function()
            json.decode('{"a" 1}')
        end)
        h.fails(function()
            json.decode("[1 2]")
        end)
        h.fails(function()
            json.decode('"open')
        end)
        h.fails(function()
            json.decode("1 2")
        end)
        h.fails(function()
            json.decode("")
        end)
    end)
end
